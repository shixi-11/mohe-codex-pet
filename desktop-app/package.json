{
  "name": "mohe-desktop-app",
  "private": true,
  "description": "Mohe (墨核) desktop companion for long-running work.",
  "author": "Shixi Lin",
  "version": "1.0.1",
  "packageManager": "pnpm@10.17.1",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4173",
    "desktop": "electron .",
    "desktop:pack": "vite build && electron-builder --win portable --x64"
  },
  "dependencies": {"react": "19.2.7", "react-dom": "19.2.7"},
  "devDependencies": {"@vitejs/plugin-react": "6.0.5", "electron": "43.4.0", "electron-builder": "26.15.3", "vite": "8.2.1"},
  "build": {
    "appId": "local.codex.mohe",
    "productName": "\u58a8\u6838",
    "directories": {"output": "release"},
    "files": ["dist/**/*", "electron/**/*", "package.json"],
    "win": {
      "icon": "mohe-icon-v3.ico",
      "target": [{"target": "portable", "arch": ["x64"]}],
      "artifactName": "\u58a8\u6838-\u684c\u9762\u7248-${version}.${ext}"
    }
  }
}
